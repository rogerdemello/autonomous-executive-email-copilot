# Autonomous Executive Email Copilot — environment configuration
# Copy to `.env` and fill in. The app runs without any of these (it falls back
# to the deterministic baseline policy), but LLM/hybrid modes need a provider.

# =============================================================================
# LLM provider — pick ONE provider below (OpenAI/Azure is the default).
# The app runs without any provider (it falls back to the deterministic baseline
# policy); LLM/hybrid modes and the benchmark `llm` agent need one.
#
# You can also set LLM_PROVIDER=openai|anthropic|gemini|ollama to explicitly
# select a provider; otherwise the first configured credential auto-selects.
# =============================================================================

# --- Provider: OpenAI / Azure OpenAI (default) -------------------------------
# --- Style A: Azure OpenAI (recommended) -------------------------------------
# Set these standard AZURE_OPENAI_* names and the app derives the base URL, key,
# version, and model automatically — no need to set Style B as well.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# Optional, only if you use embeddings:
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# --- Style B: OpenAI / OpenAI-compatible / manual --------------------------
# Standard OpenAI (or compatible) key. For Azure you can instead use Style A above.
OPENAI_API_KEY=
# Hugging Face token (used as a fallback for OPENAI_API_KEY when set).
# NOTE: HF_TOKEN takes precedence over OPENAI_API_KEY — leave blank for Azure.
HF_TOKEN=
# Base URL. For Azure (manual style) include /openai/deployments/<deployment>.
API_BASE_URL=https://api.openai.com/v1
# Primary (small/cheap) model tried first.
MODEL_NAME=gpt-4o-mini
# Larger model used as a fallback when confidence is low.
LARGER_MODEL=gpt-4o
# Confidence below which the agent retries with LARGER_MODEL (0..1).
CONFIDENCE_THRESHOLD=0.7
# Azure OpenAI API version (manual style; AZURE_OPENAI_API_VERSION wins for Style A).
AZURE_API_VERSION=2024-02-15-preview

# --- Provider: Anthropic -----------------------------------------------------
# Set ANTHROPIC_API_KEY to use Claude models directly.
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL_NAME=claude-3-5-sonnet-20241022

# --- Provider: Google Gemini -------------------------------------------------
# Set GOOGLE_API_KEY to use Gemini models directly.
# GOOGLE_API_KEY=...
# MODEL_NAME=gemini-1.5-flash

# --- Provider: Ollama (local) ------------------------------------------------
# Set OLLAMA_BASE_URL to use a local Ollama instance.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=llama3.1

# --- Style C: FREE / zero-cost OpenAI-compatible providers ------------------
# The `llm` agent works with ANY OpenAI-compatible endpoint, so you can reproduce
# the LLM benchmark column at $0. Just set OPENAI_API_KEY + API_BASE_URL + MODEL_NAME
# (Style B fields) to a free provider. Examples:
#
#   # Groq (generous free tier, OpenAI-compatible, very fast Llama models):
#   OPENAI_API_KEY=gsk_...               # from https://console.groq.com (free)
#   API_BASE_URL=https://api.groq.com/openai/v1
#   MODEL_NAME=llama-3.3-70b-versatile
#   LARGER_MODEL=llama-3.3-70b-versatile
#
#   # Local Ollama (fully free/offline; `ollama serve` + `ollama pull llama3.1`):
#   OPENAI_API_KEY=ollama                # any non-empty string
#   API_BASE_URL=http://localhost:11434/v1
#   MODEL_NAME=llama3.1
#   LARGER_MODEL=llama3.1
#
# Then: python scripts/run_benchmark.py --agents baseline multiagent llm --out artifacts/results

# --- Project data ---
# Where tasks.yaml, settings.yaml, scenarios/, and the demo mailbox live.
# Defaults to the repository's data/ directory. Set this only when running
# from an installed wheel or mounting the data elsewhere in a container.
DATA_DIR=

# --- Database ---
# Optional SQLAlchemy database URL. Leave blank to use the zero-config local
# SQLite database (the default; no extra dependencies required).
# To run on Postgres, set a URL and install the optional driver:
#   pip install "psycopg[binary]"   # SQLAlchemy 2.x psycopg3 driver
# then e.g.:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/email_copilot
# (psycopg2 also works: postgresql+psycopg2://... with `pip install psycopg2-binary`.)
# Non-SQLite URLs enable connection pooling (pool_pre_ping, pool_recycle,
# pool_size, max_overflow). psycopg is NOT a hard dependency and is imported
# only when a Postgres URL is used.
DATABASE_URL=

# --- Behavior ---
# Require human approval before reply/escalate actions (true/false/1/0/yes/no).
# Off by default; turn on for the human-in-the-loop product flow.
REQUIRE_APPROVAL=false

# How many messages one inbox sync pulls from the provider.
INBOX_SYNC_LIMIT=100

# Call the LLM to write reply and escalation prose during a sync. Off by
# default: a sync happens inside a web request, and a slow or unreachable
# provider would be felt by the user rather than by a background job.
#
# This does NOT gate model-written prose in general. Drafts already generated —
# see `python scripts/seed_demo.py --with-llm`, which commits them to
# data/demo/drafts.json — are always replayed from disk, with no network and no
# key. Turn this on to draft for a real mailbox, where nothing is pre-generated.
#
# The routing decision is never the model's either way: priority, risk and the
# choice between reply/escalate/defer/file are computed deterministically by
# app/copilot/policy.py before the drafter is called.
LLM_DRAFTING_ENABLED=false

# --- Security (all opt-in; the API runs open by default) ---
# If set, mutating routes (POST/PUT/PATCH/DELETE) require this token via
# `Authorization: Bearer <token>` or `X-API-Key`. Leave blank to run open.
API_AUTH_TOKEN=
# Comma-separated allowed CORS origins. "*" allows all (default).
CORS_ORIGINS=*
# Max requests per client IP per minute. 0 disables rate limiting (default).
RATE_LIMIT_PER_MINUTE=0

# --- Commercial SaaS layer (accounts, tenants, sales-led licensing) ---
# Deployment environment: "development" (default) or "production". In production
# the app REFUSES TO START on unsafe config — notably a missing AUTH_SECRET_KEY —
# instead of silently falling back to the well-known development secret.
ENVIRONMENT=development
# Secret used to sign session tokens AND license keys (HS256). MUST be a long
# random value in production — anyone with it can forge logins and licenses.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank ONLY for local dev/tests (an insecure dev secret is used + a
# warning is logged). Rotating it invalidates all outstanding tokens/licenses.
AUTH_SECRET_KEY=
# Session-token lifetime in minutes (default 720 = 12h).
ACCESS_TOKEN_TTL_MINUTES=720
# Set to false for a pure sales-led motion (no self-serve signup; operators
# provision orgs). Default true so the free-trial funnel works.
SIGNUP_ENABLED=true
# Optional webhook (e.g. Slack incoming webhook) that receives "Contact sales"
# and license-request leads. When blank, leads are persisted + logged only.
SALES_WEBHOOK_URL=
# Sales contact shown on the pricing/landing pages.
SALES_CONTACT_EMAIL=sales@example.com

# --- SSO (OIDC single sign-on) ---
# Server-level OpenID Connect against any compliant IdP (Okta, Entra ID, Google,
# Auth0, Keycloak). All three must be set for "Sign in with SSO" to appear;
# id_tokens are verified RS256 against the issuer's published JWKS.
# The IdP's redirect/callback URL is:  <APP_PUBLIC_URL>/auth/sso/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Transactional email (password reset, member invites) ---
# "console" (default) logs emails instead of sending — zero-config for local dev
# and tests. Set to "smtp" and fill SMTP_* below to actually send.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Public base URL used to build user-facing links (password reset / invite).
# Falls back to OAUTH_REDIRECT_BASE_URL, then APP_API_BASE_URL.
APP_PUBLIC_URL=
# How long a password-reset link stays valid, in minutes (default 60).
PASSWORD_RESET_TTL_MINUTES=60

# --- Mailbox OAuth (connect real Gmail / Microsoft 365 inboxes) ---
# Base URL of the deployed app; the OAuth redirect URI is <base>/mailbox/oauth/callback
# and must match what you register with the provider. Derived from the request
# when unset (fine for local dev; set explicitly in production).
OAUTH_REDIRECT_BASE_URL=
# Google Cloud OAuth client (Gmail). Both required to enable the Google provider.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft Entra (Azure AD) app for Microsoft 365 mail. tenant "common" allows
# any work/school or personal account; pin to your tenant id to restrict.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# --- Dashboard (React) ---
# Base URL the dashboard uses to reach the API.
APP_API_BASE_URL=http://localhost:8000

# --- Logging ---
# Root log level: DEBUG | INFO | WARNING | ERROR. Defaults to INFO.
LOG_LEVEL=INFO
