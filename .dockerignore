# Build context exclusions — keep the image small and builds fast.
.git
.github
.venv
venv
**/__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov


# Local runtime state and artifacts
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.db
artifacts
leaderboard*.csv

# Not needed at runtime — keep the image small. (reports/ and telemetry/ are
# importable packages and MUST ship; tests and docs are not.)
tests
docs
build
*.egg-info
.hypothesis
helm

# Local env and editor files
.env
.env.*
!.env.example
.idea
.vscode
.sisyphus
